# Mzigo.online deployment environment
# Copy to `.env` (never commit real secrets) and load before deployment.
# The XAMPP/dev setup works without this file using local defaults.

APP_ENV=production
APP_BASE_URL=https://app.example.co.ke
PLATFORM_ADMIN_EMAIL=admin@example.co.ke
SUPPORT_EMAIL=hello@mzigo.online

# Database (XAMPP local default is 127.0.0.1:3307 root/no password)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=mzigo_online
DB_USER=root
DB_PASS=

# Payments: demo (simulated settlement) or mpesa (Daraja integration seam)
PAYMENT_PROVIDER=demo
MPESA_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://app.example.co.ke/api/webhooks/mpesa.php

# Email: log (writes _server/logs/mail.log) or smtp
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.co.ke
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

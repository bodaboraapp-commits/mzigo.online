# Mzigo.online deployment environment
# Copy to `.env` at the project root (never commit real secrets).
# The app loads `.env` automatically; real server environment variables win.
# The XAMPP/dev setup works without this file using local defaults.

APP_ENV=production
APP_BASE_URL=https://mzigo.online
DEMO_MODE=0
PLATFORM_ADMIN_EMAIL=admin@mzigo.online
SUPPORT_EMAIL=hello@mzigo.online

# Required in production for encrypted channel credentials (32+ random chars)
APP_CONFIG_KEY=

# Database (cPanel/hosting: 127.0.0.1:3306; local XAMPP override: port 3307, user root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mzigo_online
DB_USER=mzigo_online
DB_PASS=

# Payments: demo (simulated settlement) or mpesa (Daraja integration seam)
PAYMENT_PROVIDER=demo
MPESA_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://mzigo.online/api/webhooks/mpesa.php

# Email: log (writes _server/logs/mail.log) or smtp
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@mzigo.online
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM=no-reply@mzigo.online
